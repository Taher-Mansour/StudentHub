<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter une matière"
            android:textColor="#102A43"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remplissez les informations de la matière."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etSubjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom de la matière *"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSubjectCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Code de la matière *"
            android:inputType="textCapCharacters"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSubjectTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom de l'enseignant"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSubjectDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Description de la matière"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveSubject"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Enregistrer la matière"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1565C0" />

    </LinearLayout>

</ScrollView>
